  {
    "id": "ep-rebate-get",
    "method": "GET",
    "path": "/api/rms/crs/rebates/:rebateId",
    "description": "Get rebate (rebateId ERROR500 -> 500, GATEWAY504 -> 504, unknown id -> 404)",
    "tag": "rebate",
    "enabled": true,
    "requestShape": {
      "query": "none",
      "body": "none"
    },
    "entityLink": {
      "entityName": "rebates",
      "operation": "getById"
    },
    "scenarios": [
      {
        "id": "sc-500",
        "name": "ERROR500 -> Server Error",
        "statusCode": 500,
        "delayMs": 300,
        "headers": "Content-Type: application/json",
        "body": "{ \"message\": \"Unexpected server error\" }",
        "usesEntity": false,
        "match": {
          "params.rebateId": "ERROR500"
        }
      },
      {
        "id": "sc-504",
        "name": "GATEWAY504 -> Gateway Timeout",
        "statusCode": 504,
        "delayMs": 1000,
        "headers": "Content-Type: application/json",
        "body": "{ \"message\": \"Gateway Timeout\" }",
        "usesEntity": false,
        "match": {
          "params.rebateId": "GATEWAY504"
        }
      },
      {
        "id": "sc-ok",
        "name": "Success",
        "statusCode": 200,
        "delayMs": 0,
        "headers": "Content-Type: application/json",
        "body": "{{result}}",
        "usesEntity": true
      },
      {
        "id": "sc-err",
        "name": "Always Server Error",
        "statusCode": 500,
        "delayMs": 300,
        "headers": "Content-Type: application/json",
        "body": "{ \"message\": \"Unexpected server error\" }",
        "usesEntity": false
      }
    ],
    "activeScenarioId": "sc-ok"
  },
