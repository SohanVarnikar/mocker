{
  "name": "api-mocker",
  "private": true,
  "version": "1.0.0",
  "description": "Local Node.js tool for mocking front-end APIs during development",
  "workspaces": [
    "server",
    "admin-ui"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:ui": "npm run dev --workspace admin-ui",
    "dev": "concurrently -n server,ui -c green,cyan \"npm:dev:server\" \"npm:dev:ui\"",
    "build:ui": "npm run build --workspace admin-ui",
    "start": "npm run build:ui && npm start --workspace server",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.0"
  }
}
